{
  "manifest_version": 3,
  "name": "灵闪单词",
  "version": "0.1.0",
  "description": "背单词新方式 — 每日外刊词汇 + 网页高亮闪卡",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["lib/highlighter.js", "content.js"],
    "css": ["flash.css"],
    "run_at": "document_idle"
  }],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "灵闪单词 — 打开学习面板",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
